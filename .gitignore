.cache/
models/
hf_cache/
~/.cache/huggingface/

# Índices FAISS y embeddings serializados
*.faiss
*.index
*.npy
embeddings/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
